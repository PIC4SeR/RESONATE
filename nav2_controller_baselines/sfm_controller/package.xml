<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sfm_controller</name>
  <version>0.0.0</version>
  <description>Pure SFM controller leveraging the RVO2 package</description>
  <maintainer email="anonymous@example.com">Anonymous</maintainer>
  <license>GNU General Public License 3.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rclcpp</build_depend>
  <build_depend>nav2_core</build_depend>
  <build_depend>nav2_util</build_depend>
  <build_depend>nav2_controller</build_depend>
  <build_depend>nav2_msgs</build_depend>
  <build_depend>nav2_costmap_2d</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>common_utils</build_depend>
  <build_depend>people_msgs</build_depend>
  <build_depend>visualization_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/sfm_controller.xml" />
  </export>
</package>
